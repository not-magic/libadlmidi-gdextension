[configuration]

entry_symbol = "adlmidi_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/ADLMIDI/bin/libadlmidi.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/ADLMIDI/bin/libadlmidi.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/ADLMIDI/bin/libadlmidi.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/ADLMIDI/bin/libadlmidi.windows.template_release.x86_64.dll"
macos.debug = "res://addons/ADLMIDI/bin/libadlmidi.macos.template_debug.framework"
macos.release = "res://addons/ADLMIDI/bin/libadlmidi.macos.template_release.framework"
